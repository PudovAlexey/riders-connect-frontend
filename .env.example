# Backend public URL, inlined at BUILD time by Vite.
# Local dev: leave empty — Vite proxies API + WebSocket to localhost:8080 (vite.config.ts).
# Production (Timeweb): set to your backend app URL, e.g.
#   VITE_API_URL=https://riders-backend.timeweb.cloud
VITE_API_URL=

# OpenRouteService API key for map routing (MapPage "Маршрут сюда").
# Get a free token at https://openrouteservice.org → Dashboard, then put it in
# .env.local (gitignored). Without it the route button shows a hint and no-ops.
VITE_ORS_API_KEY=
